<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="ForzaTuneLap.App.Views.VueFiltreReglages"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:ForzaTuneLap.App.Traductions"
             xmlns:vm="clr-namespace:ForzaTuneLap.App.ViewModels"
             x:DataType="vm:FiltreReglagesViewModel">

    <VerticalStackLayout Spacing="8">

        <SearchBar Placeholder="{t:Traduire Filtre_Recherche}"
                   Text="{Binding Recherche}" />

        <Button Text="{Binding TexteBoutonFiltres}"
                Command="{Binding BasculerFiltresCommand}"
                HorizontalOptions="Start" />

        <VerticalStackLayout IsVisible="{Binding FiltresVisibles}"
                             Spacing="8">

            <!-- ItemsSource doit être déclaré avant SelectedIndex. -->
            <Picker ItemsSource="{Binding Marques}"
                    SelectedIndex="{Binding IndexMarque}" />
            <Picker ItemsSource="{Binding Divisions}"
                    SelectedIndex="{Binding IndexDivision}" />
            <Picker ItemsSource="{Binding Transmissions}"
                    SelectedIndex="{Binding IndexTransmission}" />
            <Picker ItemsSource="{Binding Origines}"
                    SelectedIndex="{Binding IndexOrigine}" />

            <Label Text="{t:Traduire Filtre_Annee}" />
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8">
                <Entry Text="{Binding AnneeMinimum}"
                       Placeholder="{t:Traduire Filtre_Minimum}"
                       Keyboard="Numeric" />
                <Entry Grid.Column="1"
                       Text="{Binding AnneeMaximum}"
                       Placeholder="{t:Traduire Filtre_Maximum}"
                       Keyboard="Numeric" />
            </Grid>

            <Label Text="{t:Traduire Filtre_Indice}" />
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8">
                <Entry Text="{Binding IndiceMinimum}"
                       Placeholder="{t:Traduire Filtre_Minimum}"
                       Keyboard="Numeric" />
                <Entry Grid.Column="1"
                       Text="{Binding IndiceMaximum}"
                       Placeholder="{t:Traduire Filtre_Maximum}"
                       Keyboard="Numeric" />
            </Grid>

            <!-- Critères numériques ajoutés à la demande : bornes dans l'unité choisie. -->
            <Label Text="{t:Traduire Filtre_Criteres}"
                   Style="{StaticResource SubHeadline}" />
            <VerticalStackLayout Spacing="6"
                                 BindableLayout.ItemsSource="{Binding CriteresAffiches}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:LigneCritereFiltreViewModel">
                        <Border Padding="8"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                            <Grid ColumnDefinitions="*,*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="8"
                                  RowSpacing="4">
                                <Label Grid.ColumnSpan="2"
                                       Text="{Binding Libelle}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="2"
                                        Text="{t:Traduire Filtre_Retirer}"
                                        Command="{Binding RetirerCommand}" />
                                <Entry Grid.Row="1"
                                       Text="{Binding MinimumTexte}"
                                       Placeholder="{t:Traduire Filtre_Minimum}"
                                       Keyboard="Numeric" />
                                <Entry Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding MaximumTexte}"
                                       Placeholder="{t:Traduire Filtre_Maximum}"
                                       Keyboard="Numeric" />
                                <Label Grid.Row="1"
                                       Grid.Column="2"
                                       Text="{Binding Symbole}"
                                       VerticalOptions="Center" />
                                <Label Grid.Row="2"
                                       Grid.ColumnSpan="3"
                                       Text="{t:Traduire Edition_ValeurInvalide}"
                                       TextColor="Red"
                                       FontSize="12"
                                       IsVisible="{Binding EstInvalide}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Picker ItemsSource="{Binding CriteresDisponibles}"
                    SelectedIndex="{Binding IndexCritereAjoute}"
                    Title="{t:Traduire Filtre_ChoisirCritere}" />
            <Button Text="{t:Traduire Filtre_AjouterCritere}"
                    Command="{Binding AjouterCritereCommand}"
                    HorizontalOptions="Start" />

            <Button Text="{t:Traduire Voitures_Reinitialiser}"
                    Command="{Binding ReinitialiserCommand}"
                    HorizontalOptions="Start" />
        </VerticalStackLayout>

        <Label Text="{t:Traduire Filtre_Invalide}"
               TextColor="Red"
               FontSize="12"
               IsVisible="{Binding EstInvalide}" />

    </VerticalStackLayout>

</ContentView>
