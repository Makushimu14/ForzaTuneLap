<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ForzaTuneLap.App.Pages.PageDemarrage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:ForzaTuneLap.App.Traductions"
             xmlns:vm="clr-namespace:ForzaTuneLap.App.ViewModels"
             x:DataType="vm:DemarrageViewModel">

    <VerticalStackLayout Padding="32"
                         Spacing="20"
                         VerticalOptions="Center"
                         HorizontalOptions="Center">
        <Label Text="ForzaTuneLap"
               Style="{StaticResource Headline}"
               HorizontalOptions="Center" />
        <ActivityIndicator IsRunning="{Binding EnCours}"
                           IsVisible="{Binding EnCours}" />
        <Label Text="{Binding Message}"
               HorizontalTextAlignment="Center" />
        <Button Text="{t:Traduire Demarrage_Reessayer}"
                Command="{Binding DemarrerCommand}"
                IsVisible="{Binding EnErreur}" />
    </VerticalStackLayout>

</ContentPage>
