<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ForzaTuneLap.App.Pages.PageVoitures"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:ForzaTuneLap.App.Traductions"
             xmlns:vm="clr-namespace:ForzaTuneLap.App.ViewModels"
             x:DataType="vm:VoituresViewModel"
             Title="{t:Traduire Onglet_Voitures}">

    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="{t:Traduire Voitures_Titre}"
               Style="{StaticResource Headline}" />
        <Label Text="{Binding Resume}" />
    </VerticalStackLayout>

</ContentPage>
