<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ForzaTuneLap.App.Pages.PageVoitures"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:ForzaTuneLap.App.Traductions"
             xmlns:vm="clr-namespace:ForzaTuneLap.App.ViewModels"
             x:DataType="vm:VoituresViewModel"
             Title="{t:Traduire Onglet_Voitures}">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="12"
          RowSpacing="8">

        <SearchBar Grid.Row="0"
                   Placeholder="{t:Traduire Voitures_Recherche}"
                   Text="{Binding Recherche}" />

        <VerticalStackLayout Grid.Row="1"
                             Spacing="8">
            <HorizontalStackLayout Spacing="8">
                <Button Text="{Binding TexteBoutonFiltres}"
                        Command="{Binding BasculerFiltresCommand}" />
                <Button Text="{t:Traduire Voitures_Ajouter}"
                        Command="{Binding AjouterVoitureCommand}" />
            </HorizontalStackLayout>

            <VerticalStackLayout IsVisible="{Binding FiltresVisibles}"
                                 Spacing="8">
                <!-- ItemsSource doit être déclaré avant SelectedIndex. -->
                <Picker ItemsSource="{Binding Marques}"
                        SelectedIndex="{Binding IndexMarque}" />
                <Picker ItemsSource="{Binding Divisions}"
                        SelectedIndex="{Binding IndexDivision}" />
                <Label Text="{t:Traduire Voitures_TrierPar}" />
                <Picker ItemsSource="{Binding Tris}"
                        SelectedIndex="{Binding IndexTri}" />
                <Label Text="{t:Traduire Voitures_Ordre}" />
                <Picker ItemsSource="{Binding Ordres}"
                        SelectedIndex="{Binding IndexOrdre}" />
                <HorizontalStackLayout Spacing="8">
                    <Switch IsToggled="{Binding SeulementMesReglages}"
                            VerticalOptions="Center" />
                    <Label Text="{t:Traduire Voitures_SeulementMesReglages}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Button Text="{t:Traduire Voitures_Reinitialiser}"
                        Command="{Binding ReinitialiserCommand}"
                        HorizontalOptions="Start" />
            </VerticalStackLayout>

            <Label Text="{Binding ResumeResultat}"
                   FontAttributes="Italic" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Voitures}"
                        SelectionMode="Single"
                        SelectedItem="{Binding VoitureSelectionnee}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:LigneVoitureViewModel">
                    <Grid ColumnDefinitions="*,Auto"
                          Padding="8,10"
                          ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Titre}"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding SousTitre}"
                                   FontSize="13" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding Indice}"
                               IsVisible="{Binding AUnIndice}"
                               FontAttributes="Bold"
                               FontSize="16"
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
